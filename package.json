{
  "name": "find-sign",
  "version": "1.0.1",
  "private": true,
  "description": "Find Sign: Auslan aggregator and semantic search, as npm workspaces",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/search",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present -- --run",
    "coverage": "npm run test --workspaces --if-present -- --run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
