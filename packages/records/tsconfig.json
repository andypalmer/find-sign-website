{
	// type-checks the source and tests. node resolution, because the built package is loaded by plain node in
	// other repos (the spiders), not only by vite
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rewriteRelativeImportExtensions": true,
		"types": ["node"]
	},
	"include": ["src", "tests"]
}
