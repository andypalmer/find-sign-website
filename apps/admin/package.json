    "test": "vitest"
  },
  "devDependencies": {
    "@find-sign/test-helpers": "*",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@find-sign/core": "*",
    "@find-sign/data-io": "*",
    "@borderless/base64": "^1.0.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "nanoid": "^6.0.2",
    "svelte-tags-input": "^7.0.3",
    "tweetnacl-ts": "^1.0.3",
    "@andypalmer/indexer": "^0.1.0"
  },
  "imports": {
