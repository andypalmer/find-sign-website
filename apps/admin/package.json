{
  "name": "find-sign-admin",
  "version": "0.0.1",
  "private": true,
  "description": "Find Sign admin: index builds, overrides, users and the audit log. Holds the data server write identity",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
