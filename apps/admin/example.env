# core functionality: the same values as the public site's .env
LOCALE="en-AU"
VECTOR_INDEX="https://data.auslan.fyi/collections/wordvec/raw/commoncrawl-english-300"
SEARCH_DATA="https://data.auslan.fyi/collections/find-sign/raw/"
SEARCH_INDEX_NAME="index"
SEARCH_INDEXES="auslan-signbank,auslan-anywhere,signpedia,asphyxia,community,latrobe-ig,theatre-101,toddslan,v-alford,spread-the-sign-auslan"
ENCODED_SEARCH_DATAS="https://data.auslan.fyi/collections/encoded-search-data/raw"
VECTOR_FIDELITY="0.1"

# optional, a label to add to the passkey relying party name, e.g. "Beta"
VERSION_LABEL="Beta"

# find-sign-data identity to be able to write to /collections/search - you can get this from the create identity section of
# a find-sign-data instance. the public key side must be in the keys.json of the search collection.
# only the admin app holds this: the public site refuses to start with it set
SEARCH_WRITE_IDENTITY="redacted"

# for passkey login across multiple concurrent servers, this should be defined to a hex encoded tweetnacl sign secretKey
# setting this also makes dev reloading a lot more stable
# make sure to change this to an actual secret!!!!
# you can generate one with: node -e "console.log(Buffer.from(require('tweetnacl-ts').sign_keyPair().secretKey).toString('hex'))"
PASSKEY_CHALLENGE_SECRET="2040793fb9e98454a70e6c28269696beb8b3fa33b58c4291b3fcf1413ee5244bf5fd546e525330ed8f57f9d650d3b9473ab1a8d9804d6241848d8485621b1023"

# optional, the passkey relying party id. empty uses the request's hostname. passkeys registered when admin was at
# find.auslan.fyi/admin belong to "find.auslan.fyi": set this to that when admin runs on a subdomain such as
# admin.find.auslan.fyi, so existing passkeys keep working (a subdomain may use its parent domain as rp id)
PASSKEY_RP_ID=""

# automation key, is just any random string, that is passed as a key parameter to /automation/build-index/[provider]
# to authorize index rebuilds. Change this before deploying if you wish to restrict who can trigger intensive tasks
AUTOMATION_KEY="redacted"
