# core functionality
VITE_LOCALE="en-AU"
VITE_VECTOR_INDEX="https://data.auslan.fyi/collections/wordvec/raw/commoncrawl-english-300"
VITE_SEARCH_DATA="https://data.auslan.fyi/collections/find-sign/raw/"
